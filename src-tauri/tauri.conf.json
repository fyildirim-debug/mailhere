{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailhere",
  "mainBinaryName": "mailhere",
  "identifier": "com.furkanyildirim.mailhere",
  "build": {
    "beforeDevCommand": "pnpm --filter app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter app build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "Productivity",
    "publisher": "Furkan YILDIRIM",
    "copyright": "© 2026 Furkan YILDIRIM",
    "license": "MIT",
    "homepage": "https://github.com/fyildirim-debug/mailhere",
    "shortDescription": "Hızlı, sakin, klavyeyle yönetilen e-posta istemcisi",
    "longDescription": "Mailhere; Windows ve Linux için hızlı, sakin, klavyeyle yönetilen bir masaüstü e-posta istemcisidir.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "mail",
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
