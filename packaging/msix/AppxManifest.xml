<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) paket bildirimi. Kimlik değerleri Partner Center ›
  MailHere › Ürün kimliği sayfasındandır; değiştirilmez. Sürüm (__SURUM__)
  paketleme sırasında package.json'dan yazılır (dördüncü hane Mağaza gereği 0).
  Paket Microsoft tarafından imzalanır; burada imza yoktur.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <Identity
    Name="ArnexLab.MailHere"
    Publisher="CN=CAE57BB8-AC80-4682-AD33-4FBB0E661588"
    Version="__SURUM__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MailHere</DisplayName>
    <PublisherDisplayName>ArnexLab</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-TR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="MailHere" Executable="mailhere.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MailHere"
        Description="Hızlı, sakin, klavyeyle yönetilen e-posta istemcisi"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Açılışta başlama: tepside, pencere açmadan (src-tauri/src/autostart.rs store_task). -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="mailhere.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--tepside">
          <desktop:StartupTask TaskId="MailhereStartup" Enabled="true" DisplayName="MailHere" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
